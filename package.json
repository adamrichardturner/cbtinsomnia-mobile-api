{
  "name": "cbtinsomnia-mobile-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "db:migrate:rollback": "tsx node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "docker:env": "sh -c 'test -f .env.docker || cp .env.docker.example .env.docker'",
    "docker:build": "npm run docker:env && docker compose build",
    "docker:up": "npm run docker:env && docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart api",
    "docker:logs": "docker compose logs -f api",
    "docker:ps": "docker compose ps",
    "docker:migrate": "docker compose exec api npx tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "tsx": "^4.23.13",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
