NODE_ENV=development
PORT=4001
LOG_LEVEL=info
# Host-only URL if you run `npm run dev` against Docker Postgres.
# Inside Compose the API uses postgres:5432 instead.
DATABASE_URL=postgres://cbtinsomnia:cbtinsomnia@localhost:5433/cbtinsomnia_mobile
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
MOBILE_ORIGIN=*
APPLE_CLIENT_IDS=com.cbtinsomnia.mobile
# Comma-separated Google OAuth client IDs that may appear as the ID token audience
# (iOS client ID and Web client ID).
GOOGLE_CLIENT_IDS=
